generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuizStatus {
  draft
  approved
  archived

  @@map("quiz_status")
}

enum Difficulty {
  mixed
  easy
  medium
  hard

  @@map("difficulty")
}

enum BloomTag {
  remember
  understand
  apply
  analyze

  @@map("bloom_tag")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  materials    Material[]
  quizzes      Quiz[]

  @@map("users")
}

model Material {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  subject    String    @default("")
  bodyText   String    @map("body_text")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  quizzes    Quiz[]

  @@map("materials")
}

model Quiz {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId    String?    @map("material_id")
  material      Material?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title         String
  status        QuizStatus @default(draft)
  itemCount     Int        @default(0) @map("item_count")
  model         String     @default("")
  promptVersion String     @default("v1") @map("prompt_version")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  questions     Question[]
  tryouts       Tryout[]

  @@map("quizzes")
}

model Question {
  id            String          @id @default(cuid())
  quizId        String          @map("quiz_id")
  quiz          Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position      Int
  stem          String
  options       Json            @map("options_json")
  correctIndex  Int             @map("correct_index")
  explanation   String
  sourceExcerpt String          @default("") @map("source_excerpt")
  difficulty    Difficulty      @default(mixed)
  bloomTag      BloomTag        @default(understand) @map("bloom_tag")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  answers       AttemptAnswer[]

  @@index([quizId, position])
  @@map("questions")
}

model Tryout {
  id              String     @id @default(cuid())
  quizId          String     @map("quiz_id")
  quiz            Quiz       @relation(fields: [quizId], references: [id], onDelete: Restrict)
  token           String?    @map("token")
  tokenHash       String     @unique @map("token_hash")
  durationSeconds Int        @map("duration_seconds")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  expiresAt       DateTime?  @map("expires_at")
  attempts        Attempt[]

  @@map("tryouts")
}

model Attempt {
  id           String          @id @default(cuid())
  tryoutId     String          @map("tryout_id")
  tryout       Tryout          @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  studentLabel String          @map("student_label")
  startedAt    DateTime        @default(now()) @map("started_at")
  submittedAt  DateTime?       @map("submitted_at")
  scoreCorrect Int?            @map("score_correct")
  scoreTotal   Int?            @map("score_total")
  percent      Float?
  timedOut     Boolean         @default(false) @map("timed_out")
  createdAt    DateTime        @default(now()) @map("created_at")
  answers      AttemptAnswer[]

  @@index([tryoutId, submittedAt])
  @@map("attempts")
}

model AttemptAnswer {
  id            String   @id @default(cuid())
  attemptId     String   @map("attempt_id")
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String   @map("question_id")
  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
