# Copy to .env in the repo root for docker compose, and to apps/web/.env for Next.js.

DATABASE_URL=postgresql://cohortquiz:cohortquiz@localhost:5432/cohortquiz?schema=public

# Auth.js — generate a long random string for anything beyond local demo.
AUTH_SECRET=dev-insecure-change-me-use-a-32-char-secret
AUTH_URL=http://localhost:3000

# Next.js server → Go API (browser never calls this directly).
API_GO_URL=http://localhost:8080

# Optional. When unset, the Go service uses a deterministic mock generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8080
